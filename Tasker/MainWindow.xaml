<Window x:Class="Tasker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tasker"
        mc:Ignorable="d"
        Title="Tasker" Height="600" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#f4f6fb">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Tasks List -->
        <Border Grid.Column="0" Background="#ffffff" Margin="16" CornerRadius="18" BorderBrush="#dde4f2" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="20,18,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tasks" FontSize="24" FontWeight="Bold" Foreground="#1d2433" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="SettingsButton" Content="⚙️ Customize" Padding="10,6" Click="Settings_Click" Background="#e8ecff" Foreground="#3247ae" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="11"/>
                </Grid>

                <!-- Collapsible Add Task Section -->
                <Border x:Name="AddTaskSection" DockPanel.Dock="Top" Margin="12,0,12,10" Background="#eef4ff" CornerRadius="12" Padding="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="New Task" FontSize="14" FontWeight="Bold" Foreground="#1d2433" Margin="0,0,0,10"/>
                        
                        <TextBlock Grid.Row="1" Text="Title *" FontSize="11" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,3"/>
                        <TextBox x:Name="TodoTitleInput" Grid.Row="2" Height="32" Margin="0,0,0,8" Padding="8,4" FontSize="14" VerticalContentAlignment="Center" Text="" />
                        
                        <TextBlock Grid.Row="3" Text="Subtitle (optional)" FontSize="11" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,3"/>
                        <TextBox x:Name="TodoSubtitleInput" Grid.Row="4" Height="28" Margin="0,0,0,8" Padding="8,4" FontSize="12" VerticalContentAlignment="Center" Text="" />
                        
                        <TextBlock Grid.Row="5" Text="Description (optional)" FontSize="11" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,3"/>
                        <TextBox x:Name="TodoDescriptionInput" Grid.Row="6" Height="64" Margin="0,0,0,8" Padding="8,6" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        
                        <Grid Grid.Row="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Add task" Height="34" FontWeight="SemiBold" Click="AddTaskButton_Click" Background="#3f7af8" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            <Button Grid.Column="1" Content="Cancel" Height="34" Margin="8,0,0,0" FontWeight="SemiBold" Click="CancelAddTask_Click" Background="#e0e0e0" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Add task button -->
                <Border HorizontalAlignment="Center" Margin="16" DockPanel.Dock="bottom" CornerRadius="15"  Background="#3f7af8">
                    <StackPanel>
                            <Button x:Name="FloatingAddButton" Content="➕" Height="44" Width="150"  FontWeight="Bold" FontSize="13" Click="OpenAddTask_Click" Background="Transparent"  Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Tasks List -->
                <ListBox x:Name="TodoListBox"
                         Margin="12,0,12,12"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="TodoListBox_SelectionChanged"
                         PreviewMouseLeftButtonDown="TodoListBox_PreviewMouseLeftButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" Padding="12,10" CornerRadius="12" Background="#eef4ff">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" Focusable="False"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#19212d">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextDecorations" Value="None"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="#6b7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0" Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

        </Border>

        <!-- Right Panel: Task Details -->
        <Grid Grid.Column="1" Margin="0,16,16,16">
            <Border x:Name="DetailPanel" Background="#f9fbff" CornerRadius="18" BorderBrush="#dde4f2" BorderThickness="1" Visibility="Visible">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="SelectedTitleText" Text="Select a task" FontSize="28" FontWeight="Bold" Foreground="#1d2433"/>
                        <TextBlock x:Name="CompletionMarker" Text="✓" FontSize="22" Foreground="#1bbd7c" Margin="10,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock x:Name="SelectedSubtitleText" Text="" FontSize="13" Foreground="#64748b" Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <Button x:Name="ToggleCompleteButton" Content="Mark as complete" Margin="0,0,0,0" Padding="10,6" Click="ToggleCompleteButton_Click" Background="#e9f7ef" Foreground="#136a46" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="EditTaskButton" Content="Edit" Margin="10,0,0,0" Padding="10,6" Click="EditTaskButton_Click" Background="#e8ecff" Foreground="#3247ae" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <Grid x:Name="EditTaskGrid" Grid.Row="3" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DetailTitleInput" Grid.ColumnSpan="3" Height="32" Margin="0,0,0,10" Padding="8,4" FontSize="14" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="DetailSubtitleInput" Grid.Row="1" Grid.ColumnSpan="3" Height="28" Margin="0,0,0,10" Padding="8,4" FontSize="12" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="DetailDescriptionInput" Grid.Row="2" Grid.ColumnSpan="3" MinHeight="120" Padding="8,6" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="Save changes" Margin="0,10,8,0" Padding="12,8" Click="SaveSelectedTaskButton_Click" Background="#3f7af8" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="Delete" Margin="0,10,0,0" Padding="12,8" Click="DeleteSelectedTaskButton_Click" Background="#f8d7da" Foreground="#7f1d1d" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="4" Background="#ffffff" CornerRadius="16" BorderBrush="#e1e7f3" BorderThickness="1" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SelectedDescriptionText"
                                       Text="Choose an item from the list to view its full description here."
                                       TextWrapping="Wrap"
                                       FontSize="17"
                                       LineHeight="28"
                                       Foreground="#2b3547"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="EmptyDetailPanel" Background="#f9fbff" CornerRadius="18" BorderBrush="#dde4f2" BorderThickness="1" Visibility="Collapsed">
                <TextBlock Text="Select a task to read its description here." FontSize="20" Foreground="#6b7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
