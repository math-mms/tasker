<Window x:Class="Tasker.ActiveTaskWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tasker"
        Title="Active Task"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Left="20" Top="20">
    <Border x:Name="WidgetBorder"
            Padding="14,10"
            Background="#171A3B"
            CornerRadius="14"
            BorderBrush="#6157C8"
            BorderThickness="1"
            MaxWidth="300"
            PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown"
            PreviewMouseMove="Border_PreviewMouseMove"
            PreviewMouseLeftButtonUp="Border_PreviewMouseLeftButtonUp">
        <StackPanel Background="Transparent">
            <TextBlock x:Name="WidgetTitleText" Text="No active task" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="WidgetSubtitleText" Text="" FontSize="11" Foreground="#BFC9F5" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="WidgetDescriptionText" Text="" FontSize="12" Foreground="#BFC9F5" Margin="0,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
