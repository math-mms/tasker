<Window x:Class="Tasker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#f4f6fb">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Customization" FontSize="24" FontWeight="Bold" Foreground="#1d2433" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Background="#ffffff" Margin="0,0,0,20">
            <!-- Widget Tab -->
            <TabItem Header="Active Widget" Margin="5,0">
                <Grid Margin="15">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="Transparency" FontSize="12" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1"/>
                                <TextBlock Grid.Column="1" x:Name="OpacityValue" Text="100%" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#1d2433" FontWeight="SemiBold"/>
                            </Grid>

                            <TextBlock Text="Sizes" FontSize="12" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max Width" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="MaxWidthSlider" Minimum="200" Maximum="500" Value="300" SmallChange="10" LargeChange="50" Margin="60,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="MaxWidthValue" Text="300" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Title Size" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="WidgetTitleSizeSlider" Minimum="12" Maximum="24" Value="16" SmallChange="1" LargeChange="2" Margin="60,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="WidgetTitleSizeValue" Text="16" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtitle Size" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="WidgetSubtitleSizeSlider" Minimum="8" Maximum="16" Value="11" SmallChange="1" LargeChange="1" Margin="60,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="WidgetSubtitleSizeValue" Text="11" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <TextBlock Text="Colors" FontSize="12" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Background Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="WidgetBgColorInput" Height="32" Padding="8,4" Text="#1f2b44" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Title Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="WidgetTitleColorInput" Height="32" Padding="8,4" Text="#FFFFFF" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Text Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="WidgetTextColorInput" Height="32" Padding="8,4" Text="#DFEAFC" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Application Colors Tab -->
            <TabItem Header="App Colors" Margin="5,0">
                <Grid Margin="15">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="Main Colors" FontSize="12" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Background Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppBgColorInput" Height="32" Padding="8,4" Text="#f4f6fb" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Panel/Card Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppPanelColorInput" Height="32" Padding="8,4" Text="#ffffff" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Primary Text Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppTextColorInput" Height="32" Padding="8,4" Text="#1d2433" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Secondary Text Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppSecTextColorInput" Height="32" Padding="8,4" Text="#5e6a81" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Button Colors" FontSize="12" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Primary Button Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppPrimaryBtnColorInput" Height="32" Padding="8,4" Text="#3f7af8" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Secondary Button Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppSecBtnColorInput" Height="32" Padding="8,4" Text="#e0e0e0" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Border Color" Foreground="#333" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="AppBorderColorInput" Height="32" Padding="8,4" Text="#dde4f2" FontSize="12" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Application Fonts Tab -->
            <TabItem Header="App Fonts" Margin="5,0">
                <Grid Margin="15">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="Font Sizes" FontSize="12" FontWeight="SemiBold" Foreground="#5e6a81" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Title Font Size" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="AppTitleSizeSlider" Minimum="18" Maximum="32" Value="24" SmallChange="1" LargeChange="2" Margin="100,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="AppTitleSizeValue" Text="24" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Heading Font Size" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="AppHeadingSizeSlider" Minimum="11" Maximum="18" Value="14" SmallChange="1" LargeChange="1" Margin="100,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="AppHeadingSizeValue" Text="14" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Text Font Size" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="AppTextSizeSlider" Minimum="11" Maximum="18" Value="14" SmallChange="1" LargeChange="1" Margin="100,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="AppTextSizeValue" Text="14" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Label Font Size" Foreground="#333" VerticalAlignment="Center"/>
                                <Slider Grid.Column="0" x:Name="AppLabelSizeSlider" Minimum="9" Maximum="14" Value="12" SmallChange="1" LargeChange="1" Margin="100,0,0,0"/>
                                <TextBlock Grid.Column="1" x:Name="AppLabelSizeValue" Text="12" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="36" Padding="10,6" Click="Cancel_Click" Background="#e0e0e0" Foreground="#333" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            <Button Content="Save" Width="80" Height="36" Padding="10,6" Click="Save_Click" Background="#3f7af8" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
