<Window x:Class="Tasker.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tasker"
        Title="Choose a color" Width="520" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:ColorWheel x:Name="Wheel" Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="12,10,0,0">
                <TextBlock Text="Brightness" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1"/>
                <TextBlock Text="Hex color" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HexInput" Height="32" Padding="8,4" VerticalContentAlignment="Center" Text="#4F46E5"/>
                    <Border x:Name="ColorPreview" Grid.Column="1" Margin="8,0,0,0" BorderBrush="#777" BorderThickness="1" CornerRadius="4"/>
                </Grid>
                <TextBlock Text="Preset colors" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <UniformGrid Columns="6" Rows="2" HorizontalAlignment="Left">
                    <Button Tag="#EF4444" Background="#EF4444" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#F97316" Background="#F97316" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#F59E0B" Background="#F59E0B" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#EAB308" Background="#EAB308" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#84CC16" Background="#84CC16" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#22C55E" Background="#22C55E" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#14B8A6" Background="#14B8A6" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#06B6D4" Background="#06B6D4" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#3B82F6" Background="#3B82F6" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#6366F1" Background="#6366F1" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#A855F7" Background="#A855F7" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                    <Button Tag="#EC4899" Background="#EC4899" Click="PresetColor_Click" Margin="2" Width="30" Height="30"/>
                </UniformGrid>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="86" Height="34" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Use color" Width="96" Height="34" IsDefault="True" Click="UseColor_Click"/>
        </StackPanel>
    </Grid>
</Window>
